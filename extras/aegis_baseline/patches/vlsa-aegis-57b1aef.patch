     )
-    clean_output = response.choices[0].message.content.replace("<|begin_of_box|>", "").replace("<|end_of_box|>", "")
+    _raw = response.choices[0].message.content or ""
+    # With --reasoning-parser glm45 the chain lands in reasoning_content and `content` is
+    # already bare. Strip a leaked block anyway: a served build without the parser would
+    # otherwise return the whole chain as the obstacle name, and GroundingDINO would be
+    # handed a paragraph. Failing loudly here is better than grounding on garbage.
+    if "</think>" in _raw:
+        _raw = _raw.rsplit("</think>", 1)[1]
+    clean_output = _raw.replace("<|begin_of_box|>", "").replace("<|end_of_box|>", "").strip()
     print(clean_output)  # Output: gray cube
