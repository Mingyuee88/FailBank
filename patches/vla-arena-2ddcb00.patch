diff --git a/vla_arena/models/openpi/evaluator.py b/vla_arena/models/openpi/evaluator.py
index 204bac9..0b396a6 100644
--- a/vla_arena/models/openpi/evaluator.py
+++ b/vla_arena/models/openpi/evaluator.py
@@ -36,6 +36,7 @@ import tyro
 import yaml
 from openpi_client import image_tools
 from openpi_client import websocket_client_policy as _websocket_client_policy
+from websockets.sync.client import connect as _websocket_connect
 
 from vla_arena.models.openpi.workflow_utils import load_train_config_from_yaml
 from vla_arena.models.openpi.workflow_utils import resolve_checkpoint_dir
@@ -235,6 +236,39 @@ def _is_port_open(host: str, port: int, timeout_sec: float) -> bool:
         return False
 
 
+def _is_websocket_ready(host: str, port: int, timeout_sec: float) -> bool:
+    """Perform a protocol-valid readiness handshake without sending inference.
+
+    An open TCP port is not a ready policy server: the websocket listener binds before
+    the model has finished loading, so polling the port lets the first inference hit a
+    server that is still initialising.
+    """
+    connect_host = _normalize_host(host)
+    if connect_host == '0.0.0.0':
+        connect_host = '127.0.0.1'
+    elif connect_host == '::':
+        connect_host = '::1'
+    try:
+        with _websocket_connect(
+            f'ws://{connect_host}:{int(port)}',
+            open_timeout=float(timeout_sec),
+            close_timeout=float(timeout_sec),
+        ):
+            return True
+    except (OSError, TimeoutError):
+        return False
+
+
+def runtime_env_step(env, obs, task_description, action, cfg, t):
+    """Environment step seam used by run_episode.
+
+    The default is exactly the upstream behaviour, ``env.step(action.tolist())``.
+    External runtimes (e.g. FailBank) replace this module attribute to observe or
+    label each step; run_episode looks it up at call time.
+    """
+    return env.step(action.tolist())
+
+
 def _build_serve_policy_command(
     cfg: GenerateConfig,
     config_name: str,
@@ -292,7 +326,7 @@ def _wait_for_policy_server_ready(
                 'Auto-started OpenPI policy server exited early with code '
                 f'{process.returncode}.'
             )
-        if _is_port_open(
+        if _is_websocket_ready(
             host, port, timeout_sec=max(0.05, poll_interval_sec)
         ):
             return
@@ -534,7 +568,8 @@ def run_episode(
             action = action_plan.popleft()
 
             # Execute action in environment
-            obs, reward, done, info = env.step(action.tolist())
+            obs, reward, done, info = runtime_env_step(
+                env, obs, task_description, action, cfg, t)
             if 'cost' in info:
                 cost += info['cost']
             if done or t == max_steps + cfg.num_steps_wait - 1:
@@ -941,6 +976,12 @@ def get_vla_arena_env(
         'add_noise': add_noise,
         'light_adjustment': adjust_light,
     }
+    # The published AEGIS shield builds its obstacle cloud from agentview + backview RGB-D.
+    # Requesting the extra camera and the depth planes unconditionally would change the
+    # observation dict for every other run, so it is switched on only when asked for.
+    if os.environ.get('FAILBANK_AEGIS_CAMERAS', '0') == '1':
+        env_args['camera_names'] = ['agentview', 'robot0_eye_in_hand', 'backview']
+        env_args['camera_depths'] = True
     env = OffScreenRenderEnv(**env_args)
     return env, task_description
 
