@@ -451,11 +451,61 @@ def obstacle_detection(image, instruction, task_suite_name):
     matplotlib.use('Agg')  # ✅ Crucial: No GUI rendering
     import matplotlib.pyplot as plt
     import time
-    api_key = ""
-
-    if api_key is None or api_key == "":
-        raise ValueError("Please enter api_key")
-    client = ZhipuAiClient(api_key=api_key)  # Fill in your own APIKey
+    # README asks for the key to be pasted here. Read it from the environment
+    # instead so the secret never enters this git-tracked file; the job exports it
+    # from a 600-mode file at run time. Behaviour is otherwise unchanged: an unset
+    # variable still yields "" and still raises below.
+    import os as _os
+    api_key = _os.environ.get("ZHIPUAI_API_KEY", "")
+
+    # Local vLLM (AEGIS_GLM_BASE_URL set) or the hosted endpoint (unset). Same SDK, same
+    # model name, same prompt, same sampling; only the base URL differs, so a local/hosted
+    # difference can only come from the model.
+    _local_url = _os.environ.get("AEGIS_GLM_BASE_URL", "")
+    if _local_url:
+        # zai 0.2.3 rewrites the multimodal payload and vLLM 400s on it; the same body sent
+        # as plain JSON is accepted. Post it directly rather than fighting the SDK, and
+        # keep the call site below byte-identical by mimicking the response shape.
+        import httpx as _httpx
+
+        class _Msg:
+            def __init__(self, c): self.content = c
+        class _Choice:
+            def __init__(self, c): self.message = _Msg(c)
+        class _Resp:
+            def __init__(self, c): self.choices = [_Choice(c)]
+
+        class _Completions:
+            @staticmethod
+            def create(**kw):
+                body = {k: v for k, v in kw.items() if v is not None}
+                last = None
+                for attempt in range(5):
+                    try:
+                        r = _httpx.post(_local_url.rstrip("/") + "/chat/completions",
+                                        json=body, timeout=600.0)
+                        r.raise_for_status()
+                        return _Resp(r.json()["choices"][0]["message"].get("content") or "")
+                    except Exception as exc:
+                        last = exc
+                        if attempt == 4:
+                            raise
+                        time.sleep(min(30.0, 5.0 * (2 ** attempt)))
+                raise last
+
+        class _Chat:
+            completions = _Completions()
+
+        class _LocalClient:
+            chat = _Chat()
+
+        client = _LocalClient()
+        _thinking_kwargs = {}   # Zhipu-only body field; vLLM rejects unknown fields
+    else:
+        if api_key is None or api_key == "":
+            raise ValueError("Please enter api_key")
+        client = ZhipuAiClient(api_key=api_key)  # Fill in your own APIKey
+        _thinking_kwargs = {"thinking": {"type": "enabled"}}
     plt.imsave("obstacle_detection.png", image)
 
     image_path="obstacle_detection.png"
